<Window
    x:Class="AudioStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Audio Studio">

    <Grid Background="#101218">
    <Grid.Resources>
        <SolidColorBrush x:Key="StudioAccentBrush" Color="#77E0B5" />
        <SolidColorBrush x:Key="StudioCardBrush" Color="#1C222D" />
        <SolidColorBrush x:Key="StudioMutedBrush" Color="#BEC6D6" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#293343" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#3A4659" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="PrimaryRecordButton" TargetType="Button">
            <Setter Property="Background" Value="#77E0B5" />
            <Setter Property="Foreground" Value="#101218" />
            <Setter Property="BorderBrush" Value="#77E0B5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
    </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="18" MaxWidth="820" Margin="12,8,12,32">
            <StackPanel Spacing="5" Margin="4,0,4,6">
                <TextBlock Text="AUDIO STUDIO" FontSize="12" FontWeight="Bold" Foreground="#77E0B5" CharacterSpacing="180" />
                <TextBlock Text="Your voice. Your studio." FontSize="30" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Record clean audio, shape it, and keep every original safe." FontSize="15" Foreground="#BEC6D6" TextWrapping="Wrap" />
            </StackPanel>
            <Border Background="#171D27" CornerRadius="12" Padding="8">
            <StackPanel x:Name="WorkflowNavigation" Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="8">
                <Button Content="Record" Click="NavigateRecord_Click" />
                <Button Content="Editor" Click="NavigateEditor_Click" />
                <Button Content="Processing" Click="NavigateProcessing_Click" />
                <Button Content="Compare" Click="NavigateCompare_Click" />
            </StackPanel>
            </Border>
            <Border x:Name="RecordPanel" Background="#1C222D" CornerRadius="16" Margin="0,12,0,0">
                <StackPanel Spacing="16" Margin="24">
                    <StackPanel Spacing="5">
                        <TextBlock Text="RECORD" FontSize="11" FontWeight="Bold" Foreground="#77E0B5" CharacterSpacing="160" />
                        <TextBlock Text="Capture a clean take" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Choose your microphone, check the level, and save a WAV recording." TextWrapping="Wrap" Foreground="#BEC6D6" />
                    </StackPanel>
                    <Border Background="#171D27" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="ENGINE STATUS" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                            <TextBlock x:Name="EngineStatusText" Text="Checking native engine…" TextWrapping="Wrap" Foreground="#B4DCBE" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="INPUT DEVICE" FontSize="11" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="InputDeviceComboBox" MinWidth="260" PlaceholderText="Select microphone" />
                            <Button x:Name="RefreshInputDevicesButton" Content="Refresh" Click="RefreshInputDevices_Click" />
                        </StackPanel>
                        <TextBlock x:Name="InputDeviceStatusText" Text="Loading input devices…" TextWrapping="Wrap" Foreground="#BEC6D6" />
                    </StackPanel>
                    <Border Background="#171D27" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="RECORDING STATUS" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                            <TextBlock x:Name="RecordingStatusText" Text="Ready to record." TextWrapping="Wrap" Foreground="#F5F7FB" FontSize="15" />
                            <TextBlock x:Name="InputLevelText" Text="Input level: 0%" Foreground="#BEC6D6" />
                            <ProgressBar x:Name="InputLevelBar" Minimum="0" Maximum="1" Value="0" Height="14" Foreground="#77E0B5" />
                            <TextBlock x:Name="ClippingWarningText" Text="" TextWrapping="Wrap" Foreground="#FF7777" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="StartRecordingButton" Content="Start recording" Style="{StaticResource PrimaryRecordButton}" Click="StartRecording_Click" />
                        <Button x:Name="StopRecordingButton" Content="Stop and save" Click="StopRecording_Click" IsEnabled="False" />
                    </StackPanel>
                    <Border Background="#171D27" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RECOVERY" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                            <TextBlock Text="If an app or device interruption leaves a temporary recording, you can check a folder and recover valid audio without overwriting existing files." TextWrapping="Wrap" Foreground="#BEC6D6" />
                            <Button x:Name="RecoverRecordingsButton" Content="Check for interrupted recordings…" Click="RecoverRecordings_Click" HorizontalAlignment="Left" />
                            <TextBlock x:Name="RecoveryStatusText" Text="Recovery checks only a folder you choose and never overwrites existing recordings." TextWrapping="Wrap" Foreground="#BEC6D6" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border x:Name="ProcessingPanel" Background="#1C222D" CornerRadius="12" Margin="0,0,0,0" Visibility="Collapsed">
                <StackPanel Spacing="12" Margin="20">
                    <TextBlock Text="Processing · create a cleaned copy" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Choose a preset first. Advanced controls are kept together here. The original is never overwritten." TextWrapping="Wrap" Foreground="#BEC6D6" />
                    <TextBlock Text="Process an existing PCM16 WAV" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Creates a separate processed copy. The original is never overwritten." TextWrapping="Wrap" Foreground="#BEC6D6" />
                    <ComboBox x:Name="ProcessingPresetComboBox" PlaceholderText="Quick processing preset" SelectionChanged="ProcessingPresetComboBox_SelectionChanged">
                        <ComboBoxItem Content="Natural" />
                        <ComboBoxItem Content="Voice clarity" />
                        <ComboBoxItem Content="Rumble cut" />
                    </ComboBox>
                    <Expander Header="Advanced controls" IsExpanded="False">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock x:Name="GateThresholdText" Text="Noise threshold: -48 dBFS" Foreground="#BEC6D6" />
                            <Slider x:Name="GateThresholdSlider" Minimum="-60" Maximum="-30" Value="-48" StepFrequency="1" />
                            <TextBlock x:Name="GateAttenuationText" Text="Noise attenuation: -18 dB" Foreground="#BEC6D6" />
                            <Slider x:Name="GateAttenuationSlider" Minimum="-36" Maximum="-6" Value="-18" StepFrequency="1" />
                            <TextBlock x:Name="DspGainText" Text="Output gain: 0 dB" Foreground="#BEC6D6" />
                            <Slider x:Name="DspGainSlider" Minimum="-24" Maximum="12" Value="0" StepFrequency="1" />
                            <TextBlock x:Name="HighPassText" Text="High-pass filter: Off" Foreground="#BEC6D6" />
                            <Slider x:Name="HighPassSlider" Minimum="0" Maximum="49" Value="0" StepFrequency="1" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="ProcessWavButton" Content="Process WAV…" Click="ProcessWav_Click" />
                        <Button x:Name="CancelProcessingButton" Content="Cancel processing" Click="CancelProcessing_Click" IsEnabled="False" />
                    </StackPanel>
                    <ProgressBar x:Name="ProcessingProgressBar" Minimum="0" Maximum="1" Value="0" Height="14" />
                    <TextBlock x:Name="ProcessingStatusText" Text="Choose a PCM16 WAV to reduce low-level background noise." TextWrapping="Wrap" Foreground="#BEC6D6" />
                </StackPanel>
            </Border>
            <Border x:Name="ComparePanel" Background="#1C222D" CornerRadius="12" Margin="0,0,0,0" Visibility="Collapsed">
                <StackPanel Spacing="12" Margin="20">
                    <TextBlock Text="Preview · compare versions" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Switch between the original and processed files to judge the change by ear." TextWrapping="Wrap" Foreground="#BEC6D6" />
                    <TextBlock Text="A/B preview" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Load the original and processed WAV, then switch between them to compare." TextWrapping="Wrap" Foreground="#BEC6D6" />
                    <TextBlock x:Name="OriginalPreviewFileText" Text="Original: no file selected" TextWrapping="Wrap" Foreground="#BEC6D6" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="ChooseOriginalPreviewButton" Content="Choose original…" Click="ChooseOriginalPreview_Click" />
                        <Button x:Name="PreviewOriginalButton" Content="Preview original" Click="PreviewOriginal_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ProcessedPreviewFileText" Text="Processed: no file selected" TextWrapping="Wrap" Foreground="#BEC6D6" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="ChooseProcessedPreviewButton" Content="Choose processed…" Click="ChooseProcessedPreview_Click" />
                        <Button x:Name="PreviewProcessedButton" Content="Preview processed" Click="PreviewProcessed_Click" IsEnabled="False" />
                        <Button x:Name="StopPreviewButton" Content="Stop preview" Click="StopPreview_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="PreviewStatusText" Text="Preview is stopped." TextWrapping="Wrap" Foreground="#BEC6D6" />
                </StackPanel>
            </Border>
            <Border x:Name="EditorPanel" Background="#1C222D" CornerRadius="16" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24">
                    <StackPanel Spacing="5">
                        <TextBlock Text="EDIT" FontSize="11" FontWeight="Bold" Foreground="#77E0B5" CharacterSpacing="160" />
                        <TextBlock Text="Shape your recording" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Choose the exact section to keep, then export it as a separate WAV. Your source recording is never overwritten." TextWrapping="Wrap" Foreground="#BEC6D6" />
                    </StackPanel>
                    <Border Background="#171D27" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="WAVEFORM" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                                <TextBlock Text="Inspect the audio envelope" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Load a PCM16 WAV to view its amplitude. This analysis does not alter the recording." TextWrapping="Wrap" Foreground="#BEC6D6" />
                            </StackPanel>
                            <Button x:Name="LoadWaveformButton" Content="Load WAV waveform…" Click="LoadWaveform_Click" HorizontalAlignment="Left" />
                            <Border Background="#101218" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
                                <Canvas x:Name="WaveformCanvas" Width="560" Height="120" Background="#101218" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" Background="#FFD166" CornerRadius="2" />
                                    <TextBlock Text="Trim start" Foreground="#BEC6D6" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" Background="#FF7777" CornerRadius="2" />
                                    <TextBlock Text="Trim end" Foreground="#BEC6D6" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#171D27" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TRIM RANGE" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                                <TextBlock Text="Set your in and out points" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Move the start and end controls to select the portion you want to keep." TextWrapping="Wrap" Foreground="#BEC6D6" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TrimStartText" Text="Trim start: 0%" Foreground="#F5F7FB" FontWeight="SemiBold" />
                                <Slider x:Name="TrimStartSlider" Minimum="0" Maximum="1000" Value="0" StepFrequency="1" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TrimEndText" Text="Trim end: 100%" Foreground="#F5F7FB" FontWeight="SemiBold" />
                                <Slider x:Name="TrimEndSlider" Minimum="0" Maximum="1000" Value="1000" StepFrequency="1" />
                            </StackPanel>
                            <Border Background="#101218" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="SELECTED AUDIO" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="100" />
                                    <TextBlock x:Name="WaveformSelectionText" Text="Selected duration: full file" TextWrapping="Wrap" Foreground="#77E0B5" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="TrimWaveformButton" Content="Export selected range to new WAV…" Click="TrimWaveform_Click" IsEnabled="False" HorizontalAlignment="Left" />
                            <TextBlock Text="Export creates a new file and adds a suffix if a file with that name already exists." TextWrapping="Wrap" Foreground="#BEC6D6" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="#171D27" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="EDITOR STATUS" FontSize="10" FontWeight="Bold" Foreground="#BEC6D6" CharacterSpacing="120" />
                            <TextBlock x:Name="WaveformStatusText" Text="No waveform loaded. Choose a WAV to begin." TextWrapping="Wrap" Foreground="#BEC6D6" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
